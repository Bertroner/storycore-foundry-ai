{
  "name": "storycore-foundry-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "npm run build && electron dist/tests/electron-smoke.js",
    "package": "npm run build && node scripts/package.mjs",
    "fire-bolt:discover": "npm run build && electron dist/harness/fire-bolt/main.js",
    "test:fire-bolt-ui": "npm run build && electron dist/tests/fire-bolt-electron-smoke.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "electron": "^44.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "main": "dist/desktop/main.js",
  "author": "StoryCore Foundry AI contributors"
}
